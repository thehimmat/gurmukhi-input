{
  "$schema": "./keystrokes.schema.json",
  "version": 1,
  "cases": [
    { "name": "igurbani: sihari is typed before its consonant", "layout": "igurbani",
      "steps": [{ "type": "ikrpw" }], "expected": { "value": "ਕਿਰਪਾ" } },
    { "name": "igurbani: sihari waits for the next consonant", "layout": "igurbani",
      "steps": [{ "type": "siq" }], "expected": { "value": "ਸਤਿ" } },
    { "name": "igurbani: vwihgurU", "layout": "igurbani",
      "steps": [{ "type": "vwihgurU" }], "expected": { "value": "ਵਾਹਿਗੁਰੂ" } },
    { "name": "igurbani: a then u gives ਉ", "layout": "igurbani",
      "steps": [{ "type": "au" }], "expected": { "value": "ਉ" } },
    { "name": "igurbani: carrier vowel after a consonant", "layout": "igurbani",
      "steps": [{ "type": "hoveI" }], "expected": { "value": "ਹੋਵਈ" } },
    { "name": "igurbani: < then > gives ੴ", "layout": "igurbani",
      "steps": [{ "type": "<>" }], "expected": { "value": "ੴ" } },
    { "name": "igurbani: [ is a danda", "layout": "igurbani",
      "steps": [{ "type": "[" }], "expected": { "value": "।" } },
    { "name": "igurbani: verse number between double dandas", "layout": "igurbani",
      "steps": [{ "type": "]1]" }], "expected": { "value": "॥੧॥" } },
    { "name": "igurbani: words separated by spaces", "layout": "igurbani",
      "steps": [{ "type": "siq nwmu" }], "expected": { "value": "ਸਤਿ ਨਾਮੁ" } },
    { "name": "igurbani: typing in the middle rewrites only that word", "layout": "igurbani",
      "start": { "value": "ਸਤਿ ਨਾਮੁ", "selection": [3, 3] },
      "steps": [{ "type": "A" }], "expected": { "value": "ਸਤਿਅ ਨਾਮੁ", "selection": [4, 4] } },
    { "name": "igurbani: pasted keys are converted", "layout": "igurbani",
      "steps": [{ "paste": "siq nwmu" }], "expected": { "value": "ਸਤਿ ਨਾਮੁ" } },
    { "name": "phonetic: consonants", "layout": "phonetic",
      "steps": [{ "type": "kKgG" }], "expected": { "value": "ਕਖਗਘ" } },
    { "name": "phonetic: retroflex t/T/d/D", "layout": "phonetic",
      "steps": [{ "type": "tTdD" }], "expected": { "value": "ਟਠਡਢ" } },
    { "name": "phonetic: dental q/Q/z/Z", "layout": "phonetic",
      "steps": [{ "type": "qQzZ" }], "expected": { "value": "ਤਥਦਧ" } },
    { "name": "phonetic: nukta consonants", "layout": "phonetic",
      "steps": [{ "type": "SfL" }], "expected": { "value": "ਸ਼ਫ਼ਲ਼" } },
    { "name": "phonetic: standalone vowel at start", "layout": "phonetic",
      "steps": [{ "type": "a" }], "expected": { "value": "ਅ" } },
    { "name": "phonetic: matra after consonant", "layout": "phonetic",
      "steps": [{ "type": "ka" }], "expected": { "value": "ਕਾ" } },
    { "name": "phonetic: standalone vowel after a vowel", "layout": "phonetic",
      "steps": [{ "type": "kai" }], "expected": { "value": "ਕਾਇ" } },
    { "name": "phonetic: standalone vowel after a space", "layout": "phonetic",
      "steps": [{ "type": "k i" }], "expected": { "value": "ਕ ਇ" } },
    { "name": "phonetic: matra after nukta consonant", "layout": "phonetic",
      "steps": [{ "type": "Si" }], "expected": { "value": "ਸ਼ਿ" } },
    { "name": "phonetic: matra after subjoined consonant", "layout": "phonetic",
      "steps": [{ "type": "pR~a" }], "expected": { "value": "ਪੜ੍ਾ" } },
    { "name": "phonetic: word vahiguru", "layout": "phonetic",
      "steps": [{ "type": "vahigurU" }], "expected": { "value": "ਵਾਹਿਗੁਰੂ" } },
    { "name": "phonetic: word satinam", "layout": "phonetic",
      "steps": [{ "type": "sqinamu" }], "expected": { "value": "ਸਤਿਨਾਮੁ" } },
    { "name": "phonetic: tippi, bindi, addak", "layout": "phonetic",
      "steps": [{ "type": "s^gaMkWk" }], "expected": { "value": "ਸੰਗਾਂਕੱਕ" } },
    { "name": "phonetic: oora carrier for u", "layout": "phonetic",
      "steps": [{ "type": "u" }], "expected": { "value": "ੳ" } },
    { "name": "phonetic: unmapped digits pass through", "layout": "phonetic",
      "steps": [{ "type": "k1" }], "expected": { "value": "ਕ1" } },

    { "name": "qwerty: vowels are explicit matras", "layout": "gurmukhi-qwerty",
      "steps": [{ "type": "kakikukekoka" }], "expected": { "value": "ਕਾਕਿਕੁਕੇਕੋਕਾ" } },
    { "name": "qwerty: vowel carriers", "layout": "gurmukhi-qwerty",
      "steps": [{ "type": "wWqQ" }], "expected": { "value": "ਅਆੳੲ" } },
    { "name": "qwerty: dentals on t/d", "layout": "gurmukhi-qwerty",
      "steps": [{ "type": "tTdD" }], "expected": { "value": "ਤਥਦਧ" } },
    { "name": "qwerty: digits and dandas", "layout": "gurmukhi-qwerty",
      "steps": [{ "type": "10.>" }], "expected": { "value": "੧੦।॥" } },
    { "name": "qwerty: virama and nukta keys", "layout": "gurmukhi-qwerty",
      "steps": [{ "type": "pfrsF" }], "expected": { "value": "ਪ੍ਰਸ਼" } },
    { "name": "qwerty: ik onkar", "layout": "gurmukhi-qwerty",
      "steps": [{ "type": "V" }], "expected": { "value": "ੴ" } },
    { "name": "qwerty: word vahiguru", "layout": "gurmukhi-qwerty",
      "steps": [{ "type": "vahiguru" }], "expected": { "value": "ਵਾਹਿਗੁਰੁ" } },
    { "name": "qwerty: Option layer by code", "layout": "gurmukhi-qwerty",
      "steps": [{ "key": "†", "code": "KeyT", "alt": true }, { "key": "∂", "code": "KeyD", "alt": true }],
      "expected": { "value": "ਟਡ" } },
    { "name": "qwerty: Option+Shift layer by code", "layout": "gurmukhi-qwerty",
      "steps": [{ "key": "ˇ", "code": "KeyT", "alt": true, "shift": true }, { "key": "Î", "code": "KeyD", "alt": true, "shift": true }],
      "expected": { "value": "ਠਢ" } },
    { "name": "qwerty: Option nukta series", "layout": "gurmukhi-qwerty",
      "steps": [{ "key": "©", "code": "KeyG", "alt": true }, { "key": "∆", "code": "KeyJ", "alt": true }],
      "expected": { "value": "ਗ਼ਜ਼" } },
    { "name": "qwerty: dead key flags end of composition", "layout": "gurmukhi-qwerty",
      "steps": [{ "key": "Dead", "code": "KeyE", "alt": true }],
      "expected": { "value": "ਏ", "endComposition": true } },
    { "name": "qwerty: unmapped Option key passes through", "layout": "gurmukhi-qwerty",
      "steps": [{ "key": "Ω", "code": "KeyZ", "alt": true }], "expected": { "value": "" } },
    { "name": "phonetic: Option passes through (no Option layer)", "layout": "phonetic",
      "steps": [{ "key": "†", "code": "KeyT", "alt": true }], "expected": { "value": "" } },

    { "name": "shortcuts pass through", "layout": "phonetic",
      "steps": [{ "key": "a", "meta": true }, { "key": "c", "ctrl": true }], "expected": { "value": "" } },
    { "name": "named keys pass through", "layout": "phonetic",
      "start": { "value": "ਕ" },
      "steps": [{ "key": "Backspace" }, { "key": "ArrowLeft" }, { "key": "Enter" }], "expected": { "value": "ਕ" } },
    { "name": "system Gurmukhi keyboard passes through", "layout": "phonetic",
      "steps": [{ "key": "ਕ" }, { "key": "ਾ" }], "expected": { "value": "ਕਾ" } },

    { "name": "insert mid-text", "layout": "phonetic",
      "start": { "value": "ਕਮ", "selection": [1, 1] },
      "steps": [{ "type": "n" }], "expected": { "value": "ਕਨਮ", "selection": [2, 2] } },
    { "name": "replace a selection", "layout": "phonetic",
      "start": { "value": "ਕਮਲ", "selection": [0, 2] },
      "steps": [{ "type": "n" }], "expected": { "value": "ਨਲ", "selection": [1, 1] } },
    { "name": "vowel context comes from text before the caret", "layout": "phonetic",
      "start": { "value": "ਕਅ", "selection": [1, 1] },
      "steps": [{ "type": "a" }], "expected": { "value": "ਕਾਅ", "selection": [2, 2] } },
    { "name": "vowel at start of text before a consonant is standalone", "layout": "phonetic",
      "start": { "value": "ਕ", "selection": [0, 0] },
      "steps": [{ "type": "a" }], "expected": { "value": "ਅਕ", "selection": [1, 1] } },

    { "name": "pattern mode: syntax passes through", "layout": "phonetic", "patternMode": true,
      "steps": [{ "type": "k_*|(" }], "expected": { "value": "ਕ_*|(" } },
    { "name": "pattern mode: braces pass through even when mapped", "layout": "phonetic", "patternMode": true,
      "steps": [{ "type": "{" }], "expected": { "value": "{" } },
    { "name": "pattern mode: category names stay roman", "layout": "phonetic", "patternMode": true,
      "steps": [{ "type": "k{vowel}k" }], "expected": { "value": "ਕ{vowel}ਕ" } },
    { "name": "no pattern mode: [ is a letter in phonetic", "layout": "phonetic",
      "steps": [{ "type": "[" }], "expected": { "value": "ਞ" } },

    { "name": "paste: roman text is converted with context", "layout": "phonetic",
      "steps": [{ "paste": "vahigurU" }], "expected": { "value": "ਵਾਹਿਗੁਰੂ" } },
    { "name": "paste: context from text before the caret", "layout": "phonetic",
      "start": { "value": "ਕ" },
      "steps": [{ "paste": "a" }], "expected": { "value": "ਕਾ" } },
    { "name": "paste: unmapped characters kept", "layout": "phonetic",
      "steps": [{ "paste": "k 1!" }], "expected": { "value": "ਕ 1!" } },
    { "name": "paste: Gurmukhi passes through unchanged", "layout": "phonetic",
      "steps": [{ "paste": "ਸਤਿ nam" }], "expected": { "value": "ਸਤਿ nam" } },
    { "name": "paste: replaces a selection", "layout": "phonetic",
      "start": { "value": "ਸਮਲ", "selection": [1, 2] },
      "steps": [{ "paste": "k" }], "expected": { "value": "ਸਕਲ", "selection": [2, 2] } },
    { "name": "paste: qwerty layout", "layout": "gurmukhi-qwerty",
      "steps": [{ "paste": "vahiguru" }], "expected": { "value": "ਵਾਹਿਗੁਰੁ" } }
  ]
}
