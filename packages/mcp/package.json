{
  "name": "@atthebunga/gurmukhi-mcp",
  "version": "0.1.0",
  "description": "MCP server for Gurmukhi and Gurbani: phonetic typing, IPA pronunciation, legacy-font conversion, Gurbani search and the word dictionary",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "gurmukhi",
    "punjabi",
    "gurbani",
    "ipa",
    "dictionary"
  ],
  "author": "Himmat Singh Khalsa",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thehimmat/gurmukhi-input.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "gurmukhi-mcp": "./dist/stdio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/stdio.ts --format esm --dts --clean --target node18",
    "dev": "tsup src/index.ts src/stdio.ts --format esm --target node18 --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atthebunga/gurmukhi-core": "workspace:^",
    "@atthebunga/gurmukhi-legacy": "workspace:^",
    "@atthebunga/gurmukhi-phonetics": "workspace:^",
    "@atthebunga/gurmukhi-search-utils": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
